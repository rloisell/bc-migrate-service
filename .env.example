# bc-migrate-service — environment variables
# Copy to .env for local development. NEVER commit .env to source control.
# In production, all secrets come from Vault via External Secrets Operator.

# ── GitHub App (Copilot Extension) ────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=       # Multi-line PEM — wrap in quotes or use _FILE variant
GITHUB_APP_WEBHOOK_SECRET=

# ── LLM ───────────────────────────────────────────────────────────────────────
# GitHub Models API endpoint (uses your GitHub token — no external billing)
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
GITHUB_MODELS_API_KEY=        # GitHub PAT with models:read scope, or empty to use GITHUB_TOKEN

# LLM model to use for gap analysis
LLM_MODEL=openai/gpt-4o

# ── OpenShift Collection ───────────────────────────────────────────────────────
# Service account token used by the collector Job pod to read OCP namespaces.
# On Emerald, this is mounted from a Vault ExternalSecret.
OC_SILVER_TOKEN=
OC_SILVER_URL=https://api.silver.devops.gov.bc.ca:6443
OC_GOLD_TOKEN=
OC_GOLD_URL=https://api.gold.devops.gov.bc.ca:6443

# ── Service configuration ─────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# Working directory for collection scratch space (use /tmp in container)
WORK_DIR=/tmp/bc-migrate-work

# Path to the ocp-migration-toolkit (submodule)
TOOLKIT_PATH=./submodules/ocp-migration-toolkit

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max concurrent analysis jobs (1 per caller recommended to prevent abuse)
MAX_CONCURRENT_JOBS=3
# Max minutes a single analysis job may run before timeout
JOB_TIMEOUT_MINUTES=10
