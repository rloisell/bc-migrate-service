{
  "name": "bc-migrate-service",
  "version": "0.1.0",
  "description": "GitHub Copilot Extension — OCP migration analysis as a service",
  "private": true,
  "type": "module",
  "scripts": {
    "build":    "tsc --project tsconfig.json",
    "dev":      "tsx watch src/index.ts",
    "start":    "node dist/index.js",
    "lint":     "eslint src --ext .ts",
    "test":     "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@copilot-extensions/preview-sdk": "^1.0.0",
    "@octokit/auth-app":               "^7.0.0",
    "@octokit/rest":                   "^21.0.0",
    "fastify":                         "^5.0.0",
    "@fastify/sensible":               "^6.0.0",
    "pino":                            "^9.0.0"
  },
  "devDependencies": {
    "@types/node":          "^22.0.0",
    "typescript":           "^5.5.0",
    "tsx":                  "^4.0.0",
    "vitest":               "^2.0.0",
    "eslint":               "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser":        "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
